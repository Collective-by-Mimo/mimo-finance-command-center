# ===== Mimo Finance Command Center — required configuration =====
# PostgreSQL connection string (required)
DATABASE_URL=

# Secret used to sign login sessions (any long random string)
JWT_SECRET=

# Owner identity for the single-user auth flow
OWNER_OPEN_ID=

# Platform services (LLM, storage) — from the Manus/Forge environment
BUILT_IN_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=
OAUTH_SERVER_URL=
VITE_APP_ID=

# Gmail scanner / Sheets sync: the Apps Script Web App URL and Sheet ID
# are configured inside the app Settings page (not env vars).
NODE_ENV=development
